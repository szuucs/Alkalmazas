<Window x:Class="Cicalany.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cicalány Katalógus" Width="1120" Height="740" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Command="{Binding CatalogCommand}" Cursor="Hand" Padding="0" Margin="0"
                        MinHeight="0" VerticalAlignment="Center" ToolTip="Vissza a katalógushoz">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter />
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="CICALÁNY KATALÓGUS" Foreground="{StaticResource AccentBrush}"
                                   FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding UserName}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Content="Kijelentkezés" Command="{Binding LogoutCommand}" />
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="20,12" Background="#211B2A">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
        </Border>
        <ContentControl Content="{Binding CurrentPage}" />
    </DockPanel>
</Window>
