<Application x:Class="Cicalany.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Cicalany.Wpf.ViewModels"
             xmlns:views="clr-namespace:Cicalany.Wpf.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <SolidColorBrush x:Key="BackgroundBrush" Color="#16131D" />
        <SolidColorBrush x:Key="CardBrush" Color="#54304c" />
        <SolidColorBrush x:Key="AccentBrush" Color="#fa96e4" />
        <SolidColorBrush x:Key="TextBrush" Color="#F8F4FA" />
        <SolidColorBrush x:Key="MutedBrush" Color="#BFB4C9" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#332C3B" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#5C5068" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="38" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#332C3B" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#5C5068" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="38" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#42364E" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#1D1522" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="2,2,2,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="#752865" />
            <Setter Property="AlternatingRowBackground" Value="#302838" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeight" Value="39" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#493B55" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="Margin" Value="0,4,0,14" />
        </Style>

        <!-- Nézetmodell -> nézet párosítások. Új oldalnál ide kell felvenni egy sort. -->
        <DataTemplate DataType="{x:Type vm:AuthViewModel}"><views:AuthView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}"><views:PlaceholderView /></DataTemplate>
    </Application.Resources>
</Application>
