<UserControl x:Class="Cicalany.Wpf.Views.AuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Width="450" Padding="38" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{StaticResource CardBrush}" CornerRadius="14">
            <StackPanel>
                <TextBlock Text="Üdv a katalógusban!" FontSize="27" FontWeight="Bold" />
                <TextBlock Text="Bejelentkezés meglévő fiókkal, vagy új fiók létrehozása."
                           Foreground="{StaticResource MutedBrush}" Margin="0,10,0,28" />
                <TextBlock Text="Felhasználónév" Margin="0,0,0,8" />
                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" />
                <TextBlock Text="Jelszó" Margin="0,22,0,8" />
                <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordInput_OnPasswordChanged" />
                <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                    <Button Content="Belépés" Style="{StaticResource PrimaryButton}" Command="{Binding LoginCommand}" />
                    <Button Content="Regisztráció" Command="{Binding RegisterCommand}" />
                </StackPanel>
                <TextBlock Text="Regisztrációnál legalább 3 karakteres név és 6 karakteres jelszó kell."
                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,18,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
