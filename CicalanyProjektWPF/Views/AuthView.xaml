<UserControl x:Class="Cicalany.Wpf.Views.AuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Width="450" Padding="38" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{StaticResource CardBrush}" CornerRadius="14">
            <StackPanel>
                <TextBlock Text="Üdv a cicalány katalógusban!" FontSize="27" FontWeight="Bold" Margin="0,5,0,40"/>

                <TextBlock Text="Felhasználónév" Margin="0,0,0,8" />
                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" />
                <TextBlock Text="Jelszó" Margin="0,22,0,8" />
                <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordInput_OnPasswordChanged" />
                <TextBlock Text="Felhasználónév legalább 3 karakter, illetve jelszó minimum 6."
                           Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <StackPanel Margin="0,38,0,0" HorizontalAlignment="Center" Orientation="Vertical">
                    <Button Content="Belépés" Width="180" Margin="0,0,0,10" Style="{StaticResource PrimaryButton}" Command="{Binding LoginCommand}" />
                    <Button Content="Regisztráció" Width="180" Command="{Binding RegisterCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
