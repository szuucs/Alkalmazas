<UserControl x:Class="Cicalany.Wpf.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Cicálányok" FontWeight="Bold" FontSize="30" />
            <TextBlock Text="Válaszd ki, kiket szeretnél a kosárba tenni."
                       Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,7,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding CatGirls}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="236" Margin="0,0,18,18" Padding="18" CornerRadius="12"
                                Background="{StaticResource CardBrush}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}"
                                           FontSize="12" Margin="0,6,0,0" />
                                <Button Content="Kosárba" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"
                                        HorizontalAlignment="Left"
                                        CommandParameter="{Binding}"
                                        Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock Grid.Row="1" Text="Nincs megjeleníthető cicálány." Foreground="{StaticResource MutedBrush}"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
