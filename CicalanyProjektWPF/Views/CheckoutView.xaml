<UserControl x:Class="Cicalany.Wpf.Views.CheckoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Width="510" Background="{StaticResource CardBrush}" Padding="34" CornerRadius="12"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Rendelés leadása" FontSize="29" FontWeight="Bold" Margin="0,0,0,12" />
                <TextBlock Text="Add meg a dátumot (nyilakkal vagy a gombokkal is állíthatod) és a helyszínt. A mezőknek van előre beállított értéke, ezeket módosíthatod."
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,24" />
                <TextBlock Text="Dátum" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="‹" FontSize="20" Padding="16,4" Margin="0,0,8,0"
                            Command="{Binding PreviousDayCommand}" ToolTip="Előző nap" />
                    <TextBox Grid.Column="1" Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}"
                             TextAlignment="Center" MaxLength="16" />
                    <Button Grid.Column="2" Content="›" FontSize="20" Padding="16,4" Margin="8,0,0,0"
                            Command="{Binding NextDayCommand}" ToolTip="Következő nap" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Ma" Command="{Binding TodayCommand}" Padding="14,6" MinHeight="32" />
                    <Button Content="Holnap" Command="{Binding TomorrowCommand}" Padding="14,6" MinHeight="32" />
                    <Button Content="+1 hét" Command="{Binding NextWeekCommand}" Padding="14,6" MinHeight="32" Margin="0" />
                </StackPanel>
                <TextBlock Text="Helyszín" Margin="0,22,0,8" />
                <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" />
                <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                    <Button Content="Rendelés véglegesítése" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ConfirmCommand}" />
                    <Button Content="Vissza" Command="{Binding BackCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
