<UserControl x:Class="Cicalany.Wpf.Views.CheckoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Width="510" Background="{StaticResource CardBrush}" Padding="34" CornerRadius="12"
                HorizontalAlignment="Center" Margin="0,24">
            <StackPanel>
                <TextBlock Text="Rendelés leadása" FontSize="29" FontWeight="Bold" Margin="0,0,0,12" />

                <Border Background="#33000000" CornerRadius="8" Padding="14,12" Margin="0,0,0,22">
                    <StackPanel>
                        <TextBlock Text="Fizetés a helyszínen" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="A rendelés leadásakor nem kell fizetned, az összeget a helyszínen tudod kifizetni."
                                   Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Add meg a dátumot és az időpontot (nyilakkal vagy a gombokkal is állíthatod), valamint a helyszínt."
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,22" />

                <TextBlock Text="Dátum" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="‹" FontSize="20" Padding="16,4" Margin="0,0,8,0"
                            Command="{Binding PreviousDayCommand}" ToolTip="Előző nap" />
                    <TextBox Grid.Column="1" Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}"
                             TextAlignment="Center" MaxLength="16" />
                    <Button Grid.Column="2" Content="›" FontSize="20" Padding="16,4" Margin="8,0,0,0"
                            Command="{Binding NextDayCommand}" ToolTip="Következő nap" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Ma" Command="{Binding TodayCommand}" Padding="14,6" MinHeight="32" />
                    <Button Content="Holnap" Command="{Binding TomorrowCommand}" Padding="14,6" MinHeight="32" />
                    <Button Content="+1 hét" Command="{Binding NextWeekCommand}" Padding="14,6" MinHeight="32" Margin="0" />
                </StackPanel>

                <TextBlock Text="Időpont (kezdés)" Margin="0,22,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="‹" FontSize="20" Padding="16,4" Margin="0,0,8,0"
                            Command="{Binding PreviousHourCommand}" ToolTip="Egy órával korábban" />
                    <TextBox Grid.Column="1" Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}"
                             TextAlignment="Center" MaxLength="5" />
                    <Button Grid.Column="2" Content="›" FontSize="20" Padding="16,4" Margin="8,0,0,0"
                            Command="{Binding NextHourCommand}" ToolTip="Egy órával később" />
                </Grid>
                <TextBlock Text="{Binding AvailabilityText}" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" Margin="0,12,0,0" />
                <TextBlock Text="{Binding DurationText}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                           Margin="0,4,0,0" />

                <TextBlock Text="Név *" Margin="0,22,0,8" />
                <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />

                <TextBlock Text="E-mail *" Margin="0,18,0,8" />
                <TextBox Text="{Binding CustomerEmail, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" />

                <TextBlock Text="Telefonszám *" Margin="0,18,0,8" />
                <TextBox Text="{Binding CustomerPhone, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" />

                <TextBlock Text="Helyszín" Margin="0,22,0,8" />
                <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" />

                <TextBlock Text="Fizetés a helyszínen." Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                           Margin="0,24,0,0" />

                <Border Background="#33000000" CornerRadius="8" Padding="14,12" Margin="0,16,0,0">
                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
                               Text="Szolgáltatásunk kizárólag társasági és szórakoztató jellegű." />
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="Rendelés véglegesítése" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ConfirmCommand}" />
                    <Button Content="Vissza" Command="{Binding BackCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
