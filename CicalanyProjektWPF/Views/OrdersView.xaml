<UserControl x:Class="Cicalany.Wpf.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Rendeléseim" FontSize="30" FontWeight="Bold" Margin="0,0,0,22" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Orders}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="22,18"
                                Margin="0,0,10,16">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TotalLabel}" FontSize="19" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock FontSize="21" FontWeight="Bold" Foreground="{StaticResource AccentBrush}">
                                        <Run Text="Rendelés #" /><Run Text="{Binding Id, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>
                                <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0">
                                    <Run Text="Dátum: " /><Run Text="{Binding DateLabel, Mode=OneWay}" />
                                    <Run Text="     Időpont: " /><Run Text="{Binding TimeLabel, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0">
                                    <Run Text="Helyszín: " /><Run Text="{Binding Location, Mode=OneWay}" />
                                    <Run Text="     Fizetés a helyszínen." />
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"
                                           Visibility="{Binding HasContact, Converter={StaticResource BoolToVisibility}}">
                                    <Run Text="Megrendelő: " /><Run Text="{Binding ContactLabel, Mode=OneWay}" />
                                </TextBlock>
                                <Border Height="16" />

                                <Grid Margin="10,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Cicálány" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="Életkor" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                    <TextBlock Grid.Column="2" Text="Magasság" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                    <TextBlock Grid.Column="3" Text="Súly" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                    <TextBlock Grid.Column="4" Text="Ár" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Lines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#33000000" CornerRadius="6" Padding="10,9" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="120" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding AgeLabel}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding HeightLabel}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding WeightLabel}" />
                                                    <TextBlock Grid.Column="4" Text="{Binding PriceLabel}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock Grid.Row="1" Text="Még nincs leadott rendelésed." Foreground="{StaticResource MutedBrush}"
                   FontSize="15" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
